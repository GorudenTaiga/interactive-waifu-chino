# ==============================================================================
# KONFIGURASI SERVER & AI - KAFUU CHINO 3D INTERAKTIF
# ==============================================================================

# Port Backend Server
PORT=3000

# Provider AI yang digunakan: "auto", "openai", "ollama", atau "mock"
# - "auto" : Coba OpenAI dulu jika ada API Key, jika gagal coba Ollama, jika tidak ada masuk ke Smart Mock.
# - "openai" : Wajib OpenAI (GPT-4o-mini / GPT-4o)
# - "ollama" : Menggunakan Ollama Local (misal Qwen2.5 / Llama3)
# - "mock" : Offline Fallback Simulation
AI_PROVIDER=auto

# ------------------------------------------------------------------------------
# 1. KONFIGURASI OPENAI API (Cloud AI)
# Cara dapatkan API Key:
# 1. Buka https://platform.openai.com/
# 2. Login/Daftar -> Menu "API Keys" -> Klik "Create new secret key"
# 3. Masukkan key di bawah (awalan sk-...)
# ------------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ------------------------------------------------------------------------------
# 2. KONFIGURASI OLLAMA AI (Local AI - Tanpa Internet / Gratis)
# Cara gunakan:
# 1. Download & install Ollama dari https://ollama.com/
# 2. Buka terminal lalu jalankan: ollama run qwen2.5:7b (atau llama3:8b)
# 3. Pastikan Ollama running di background pada port 11434
# ------------------------------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:latest

# ------------------------------------------------------------------------------
# 3. KONFIGURASI CUSTOM VOICE MODEL (TTS Eksternal / Kustom)
# Jika kamu memiliki API endpoint TTS kustom (Voicevox / RVC / ElevenLabs / dll):
# Set CUSTOM_TTS_ENABLED=true dan masukkan endpoint URL-nya.
# Jika false, web app akan menggunakan Web Speech API bawaan browser secara otomatis.
# ------------------------------------------------------------------------------
CUSTOM_TTS_ENABLED=false
CUSTOM_TTS_ENDPOINT=http://localhost:50021/voice
