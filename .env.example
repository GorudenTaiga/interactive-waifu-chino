# ==============================================================================
# KONFIGURASI SERVER & AI - KAFUU CHINO 3D INTERAKTIF
# ==============================================================================

# Port Backend Server
PORT=3000

# Provider AI yang digunakan: "auto", "openai", "ollama", atau "mock"
# - "auto" : Coba OpenAI dulu jika ada API Key, jika gagal coba Ollama, jika tidak ada masuk ke Smart Mock.
# - "openai" : Wajib OpenAI (GPT-4o-mini / GPT-4o)
# - "ollama" : Menggunakan Ollama Local (misal Qwen2.5 / Llama3)
# - "mock" : Offline Fallback Simulation
AI_PROVIDER=auto

# ------------------------------------------------------------------------------
# 1. KONFIGURASI OPENAI API (Cloud AI)
# Cara dapatkan API Key:
# 1. Buka https://platform.openai.com/
# 2. Login/Daftar -> Menu "API Keys" -> Klik "Create new secret key"
# 3. Masukkan key di bawah (awalan sk-...)
# ------------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ------------------------------------------------------------------------------
# 2. KONFIGURASI OLLAMA AI (Local AI - Tanpa Internet / Gratis)
# Cara gunakan:
# 1. Download & install Ollama dari https://ollama.com/
# 2. Buka terminal lalu jalankan: ollama run qwen2.5:7b (atau llama3:8b)
# 3. Pastikan Ollama running di background pada port 11434
# ------------------------------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:latest

# ------------------------------------------------------------------------------
# 3. KONFIGURASI CUSTOM VOICE MODEL — RVC (Retrieval-based Voice Conversion)
# RVC API Server berjalan di port 50051 menggunakan model Kafuu Chino.
# Pastikan server RVC sudah running sebelum chat dimulai.
# Jalankan dengan: npm run rvc  (atau otomatis via: npm run dev)
# ------------------------------------------------------------------------------
CUSTOM_TTS_ENABLED=true
CUSTOM_TTS_ENDPOINT=http://localhost:50051/synthesize

# Path ke voice model RVC (relatif dari root project)
RVC_MODEL_PATH=voice_model/chinno-kafuu.pth
RVC_INDEX_PATH=voice_model/added_IVF209_Flat_nprobe_1_chinno-kafuu_v2.index

# Port FastAPI RVC Server
RVC_PORT=50051

# Parameter konversi suara
# RVC_PITCH: pitch shift dalam semitones (0 = tidak berubah, -2~-4 = lebih feminin)
RVC_PITCH=0
# RVC_INDEX_RATE: 0.0~1.0, seberapa kuat pengaruh FAISS index (0.75 direkomendasikan)
RVC_INDEX_RATE=0.75
# RVC_F0_METHOD: metode ekstraksi pitch (rmvpe lebih akurat, pm lebih cepat)
RVC_F0_METHOD=rmvpe
# RVC_PROTECT: proteksi konsonan/napas 0.0~0.5 (0.33 default)
RVC_PROTECT=0.33
