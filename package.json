{
  "name": "chino-3d-interaktif",
  "version": "1.0.0",
  "description": "Platform Web Interaktif 3D Kafuu Chino (.pmx) dengan Three.js, Socket.io, OpenAI, dan TTS Voice",
  "main": "server/server.js",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"cyan,magenta\" \"npm run server\" \"npm run client\"",
    "server": "node server/server.js",
    "client": "vite",
    "build": "vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "axios": "^1.7.9",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "mmd-parser": "^1.0.4",
    "openai": "^4.86.1",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "three": "^0.160.0"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "vite": "^6.2.0"
  }
}
